# 调试模式配置
SKIP_DATABASE=true
LOG_LEVEL=debug
GIN_MODE=debug

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5876

# 数据库配置（调试时跳过）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME=aura_postgresql
DATABASE_USER=test
DATABASE_PASSWORD=test
DATABASE_SSLMODE=disable
DATABASE_SCHEMA=public

# OpenAI 配置
OPENAI_API_KEY=test_key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-3.5-turbo

# 应用配置
APP_DEBUG=true
APP_VERSION=1.0.0
LOG_DIR=./logs

# 配置路径
CONFIG_PATH=.


